      "wav_path": "/home/antigravity/rradkch-svg/CTS/episodios/ep01_elevator_safety_brake/cache/tts/b03_cable_redundancy_ce14aa9867f0.wav",
      "narration_text": "First, modern elevators never hang from one rope. Six to eight braided steel cables share the load."
    },
    {
      "id": "b04_load_factor",
      "start_s": 18.49,
      "end_s": 23.59,
