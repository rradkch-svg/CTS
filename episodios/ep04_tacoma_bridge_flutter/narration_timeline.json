      "start_s": 38.0281,
      "end_s": 44.2004,
      "wav_path": "/home/antigravity/rradkch-svg/CTS/episodios/ep04_tacoma_bridge_flutter/cache/tts/b07_negative_damping_18ffacba68f4.wav",
      "narration_text": "Every upward pitch let wind push even harder in the same direction. Zero damping."
    },
    {
